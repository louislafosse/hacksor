# Hacksor all-in-one runtime: a Kali Linux container with Codex + OpenCodex +
# the full Kali hacking arsenal. Users only need Docker; Hacksor runs the agent
# inside this container, so the whole pentest environment is bundled.
FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# Pin Kali's Cloudflare CDN, which serves .deb files directly. The default
# http.kali.org redirector rotates to volunteer mirrors, some of which have a
# broken TLS cert (SSL certificate verify failed) and abort the build.
RUN echo "deb http://kali.download/kali kali-rolling main contrib non-free non-free-firmware" > /etc/apt/sources.list

# Core system + the Kali toolset. Kali's repos carry all of these, so no
# per-tool source builds are needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git curl wget jq ripgrep unzip zip file build-essential \
    python3 python3-pip python3-venv pipx golang \
    # network / recon
    nmap masscan dnsutils whois netcat-traditional socat tcpdump iproute2 iputils-ping \
    openssl openssh-client proxychains4 \
    # VPN clients (reach targets over a tunnel) + sudo
    openvpn wireguard-tools iptables sudo \
    # web / app testing
    nikto whatweb wfuzz dirb dirbuster sqlmap hydra medusa \
    feroxbuster ffuf gobuster nuclei amass \
    # projectdiscovery + crawling
    httpx-toolkit subfinder naabu katana dnsx \
    # intercepting proxy + browser
    mitmproxy chromium chromium-driver fonts-liberation \
    # TLS / forensics / misc
    testssl.sh binwalk exiftool john hashid hashcat \
    # wordlists + exploit DB
    seclists wordlists exploitdb \
    # nodejs (for codex/ocx/playwright)
    nodejs npm \
 && rm -rf /var/lib/apt/lists/*

# GitHub CLI (gh) — PoC/exploit repo + code search (not in Kali apt).
RUN mkdir -p -m 755 /etc/apt/keyrings \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh && rm -rf /var/lib/apt/lists/*

# Some Kali packages install as *-toolkit or under /usr/bin with variant names;
# add convenient aliases the agent expects.
RUN ln -sf "$(command -v httpx-toolkit 2>/dev/null || echo /usr/bin/httpx)" /usr/local/bin/httpx 2>/dev/null || true
# Kali packages testssl as `testssl` (no .sh); expose the familiar name too.
RUN ln -sf "$(command -v testssl 2>/dev/null || echo /usr/bin/testssl)" /usr/local/bin/testssl.sh 2>/dev/null || true

# Extra Go tools not packaged (best-effort; the apt set above already covers most).
ENV GOPATH=/usr/local/gopath
ENV PATH="/usr/local/gopath/bin:${PATH}"
RUN go install -v github.com/hahwul/dalfox/v2@latest 2>/dev/null; \
    go install -v github.com/projectdiscovery/cvemap/cmd/cvemap@latest 2>/dev/null; \
    go install -v github.com/projectdiscovery/interactsh/cmd/interactsh-client@latest 2>/dev/null; \
    go install -v github.com/hakluke/hakrawler@latest 2>/dev/null; \
    go install -v github.com/lc/gau/v2/cmd/gau@latest 2>/dev/null; \
    go install -v github.com/tomnomnom/waybackurls@latest 2>/dev/null; \
    # recon expansion: ASN/CIDR, TLS grab, engine search, screenshots, param grep
    go install -v github.com/projectdiscovery/asnmap/cmd/asnmap@latest 2>/dev/null; \
    go install -v github.com/projectdiscovery/mapcidr/cmd/mapcidr@latest 2>/dev/null; \
    go install -v github.com/projectdiscovery/tlsx/cmd/tlsx@latest 2>/dev/null; \
    go install -v github.com/projectdiscovery/uncover/cmd/uncover@latest 2>/dev/null; \
    go install -v github.com/tomnomnom/assetfinder@latest 2>/dev/null; \
    go install -v github.com/tomnomnom/gf@latest 2>/dev/null; \
    # gowitness: its go.mod carries replace directives, which `go install` refuses;
    # build it from a clone (as the main module those directives are honored).
    (rm -rf /tmp/gowitness && git clone --depth 1 https://github.com/sensepost/gowitness /tmp/gowitness \
      && cd /tmp/gowitness && go build -o /usr/local/gopath/bin/gowitness . && cd / && rm -rf /tmp/gowitness) 2>/dev/null; \
    # secrets scanning, cloud enum, API route discovery
    go install -v github.com/gitleaks/gitleaks/v8@latest 2>/dev/null; \
    go install -v github.com/BishopFox/cloudfox@latest 2>/dev/null; \
    go install -v github.com/assetnote/kiterunner/cmd/kiterunner@latest 2>/dev/null; \
    rm -rf /usr/local/gopath/pkg /root/.cache/go-build || true

# gf pattern set (xss/ssrf/sqli/lfi/redirect param greps)
RUN git clone --depth 1 https://github.com/1ndianl33t/Gf-Patterns /root/.gf 2>/dev/null || true

# pipx tools go to a WORLD-READABLE location, not root's ~/.local: on Linux the
# agent runs as the host uid (not root), and /root/.local is 0700 -> the agent
# gets "command not found" for every pipx tool. PIPX_HOME under /opt + shims in
# /usr/local/bin (already on PATH for all users) fixes that; each tool still lands
# in its own venv so incompatible deps (e.g. semgrep pydantic 2 vs prowler
# pydantic 1) don't collide. A final chmod (in the tools block) makes /opt/pipx
# traversable by everyone.
ENV PIPX_HOME=/opt/pipx
ENV PIPX_BIN_DIR=/usr/local/bin
# arjun (params), wafw00f (WAF detect), s3scanner (bucket enum)
RUN pipx install arjun 2>/dev/null || pip install --break-system-packages arjun || true
RUN pipx install wafw00f 2>/dev/null || pip install --break-system-packages wafw00f || true
RUN pipx install s3scanner 2>/dev/null || pip install --break-system-packages s3scanner || true
ENV PATH="/root/.local/bin:${PATH}"

# ---- Strix-parity additions: SAST, secrets, exploit + cloud tooling ----
# SAST (semgrep) and cloud audit (scoutsuite, prowler). Heavy Python; best-effort.
RUN pipx install semgrep 2>/dev/null || pip install --break-system-packages semgrep || true
RUN pipx install scoutsuite 2>/dev/null || pip install --break-system-packages scoutsuite || true
RUN pipx install prowler 2>/dev/null || pip install --break-system-packages prowler || true
# Make every pipx venv readable/traversable by the non-root agent uid.
RUN chmod -R a+rX /opt/pipx 2>/dev/null || true

# Secrets scanning: trufflehog (official installer; gitleaks comes from the go block).
RUN (curl -sSfL https://raw.githubusercontent.com/trufflesecurity/trufflehog/main/scripts/install.sh | sh -s -- -b /usr/local/bin) 2>/dev/null || true

# Java + PHP runtimes for the deserialization gadget-chain tools below.
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends default-jre-headless php-cli 2>/dev/null; rm -rf /var/lib/apt/lists/* 2>/dev/null || true

# jwt_tool (JWT attacks), SSTImap (server-side template injection), phpggc (PHP
# gadget chains), ysoserial (Java gadget chains). Cloned/fetched + thin wrappers.
RUN git clone --depth 1 https://github.com/ticarpi/jwt_tool /opt/jwt_tool 2>/dev/null && (pip install --break-system-packages pycryptodomex termcolor cprint requests 2>/dev/null || true) && printf '#!/bin/sh\nexec python3 /opt/jwt_tool/jwt_tool.py "$@"\n' > /usr/local/bin/jwt_tool && chmod +x /usr/local/bin/jwt_tool || true
RUN git clone --depth 1 https://github.com/vladko312/SSTImap /opt/SSTImap 2>/dev/null && (pip install --break-system-packages -r /opt/SSTImap/requirements.txt 2>/dev/null || true) && printf '#!/bin/sh\nexec python3 /opt/SSTImap/sstimap.py "$@"\n' > /usr/local/bin/sstimap && chmod +x /usr/local/bin/sstimap || true
RUN git clone --depth 1 https://github.com/ambionics/phpggc /opt/phpggc 2>/dev/null && printf '#!/bin/sh\nexec php /opt/phpggc/phpggc "$@"\n' > /usr/local/bin/phpggc && chmod +x /usr/local/bin/phpggc || true
RUN (curl -sSfL -o /opt/ysoserial.jar https://github.com/frohoff/ysoserial/releases/latest/download/ysoserial-all.jar 2>/dev/null) && printf '#!/bin/sh\nexec java -jar /opt/ysoserial.jar "$@"\n' > /usr/local/bin/ysoserial && chmod +x /usr/local/bin/ysoserial || true

# hacksor-findings: structured vulnerability knowledge base + Markdown report
# generator (base64-embedded stdlib CLI; no COPY, builds under every builder).
RUN echo '' | base64 -d > /usr/local/bin/hacksor-findings && chmod +x /usr/local/bin/hacksor-findings


# Codex CLI (app-server) + OpenCodex proxy (ocx) + browser control.
# Primary browser: Camoufox (stealth Firefox) via camofox-browser + camofox-mcp
# — resists Cloudflare/Turnstile and humanizes clicks/typing. agent-browser and
# Playwright/Chromium remain as fallbacks.
# Firefox runtime deps Camoufox needs (Kali has most, add the GTK/X/audio libs)
# plus: xvfb+xauth (virtual display — camofox-browser needs a display), x11vnc +
# websockify (headed/VNC display mode via the MCP `toggle_display`), and
# libnss3-tools (certutil — trust the mitmproxy CA in a browser profile).
# Note: pick libasound2t64 (Debian/Kali time_t transition) when present, else
# the classic libasound2 — the bare name has no install candidate on current
# Kali. Retries make the step tolerant of a flaky mirror.
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    libgtk-3-0 libdbus-glib-1-2 libxtst6 libxt6 libx11-xcb1 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libpci3 xauth xvfb \
    x11vnc websockify libnss3-tools \
    "$(apt-cache show libasound2t64 >/dev/null 2>&1 && echo libasound2t64 || echo libasound2)" \
 && rm -rf /var/lib/apt/lists/*
ENV CHROME_BIN=/usr/bin/chromium
ENV PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/playwright
# Retry config makes the global install tolerant of a flaky registry connection
# (ECONNRESET / TLS disconnects seen on slow links).
RUN npm config set fetch-retries 6 \
 && npm config set fetch-retry-mintimeout 20000 \
 && npm config set fetch-retry-maxtimeout 180000 \
 && npm config set fetch-timeout 600000 \
 && npm install -g @openai/codex @bitkyc08/opencodex @playwright/mcp agent-browser \
    camofox-mcp camofox-browser \
 && (PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/playwright npx -y playwright install chromium 2>/dev/null || true) \
 && npm cache clean --force

# Patch the installed camofox-browser + camofox-mcp so the MCP browser can solve
# Cloudflare Turnstile, work behind the loopback intercept proxy, and lazy-start
# the heavy Firefox only when actually used. The patch script (3 files) is
# base64-embedded so no shell escaping can corrupt it and it builds identically
# under BuildKit, the classic builder, and the in-app bollard build. Idempotent +
# best-effort.
#   - camofox-browser context-pool.js: disable_coop (click the cross-origin
#     Turnstile iframe), ignoreHTTPSErrors (browse through the proxy), geoip gated
#     off for loopback proxies (the public-IP probe fails through mitmproxy and
#     blocked create_tab).
#   - camofox-browser tab.js: when a page-level selector click fails (element is
#     in a cross-origin iframe / closed shadow root), walk child frames and click
#     by bbox centre with a real mouse sequence — so the existing MCP `click` tool
#     solves Turnstile.
#   - camofox-mcp client.js: LAZY-START — the first browser API request ensures the
#     daemon is up (health-check, then `camofox-browser server start --background`
#     with the RAM caps), so the heavy Firefox stays down until a browser tool is
#     actually used instead of autostarting with the container.
# Because we patch the INSTALLED packages, the runtime must launch these binaries
# (it does — the app/MCP run `camofox-browser`/`camofox-mcp`, not `npx @latest`).
RUN echo '' \
    | base64 -d > /tmp/hacksor-cb-patch.js \
 && node /tmp/hacksor-cb-patch.js \
 && rm -f /tmp/hacksor-cb-patch.js

# cloudfish: passive subdomain discovery via Cloudflare's own DNS scanner (a data
# source distinct from CT logs / passive DNS). Reworked stdlib-only CLI, base64
# embedded (no COPY; builds under every builder). Creds come from Hacksor Settings
# (written to ~/.cloudflare, bind-mounted into the container) or -k/-e/-a flags.
RUN echo '' | base64 -d > /usr/local/bin/cloudfish && chmod +x /usr/local/bin/cloudfish

# Pre-fetch the Camoufox engine so the first browser use isn't a slow 1.3 GB
# download at runtime (best-effort — camofox-browser downloads it otherwise).
# Time-bounded so a slow/flaky link can't hang the build for hours; if it's
# skipped, camofox-browser fetches the engine on first use.
RUN (timeout 1800 camofox-browser fetch 2>/dev/null || timeout 1800 npx -y camofox-browser@latest fetch 2>/dev/null || true)

# Pre-fetch nuclei templates so the first scan is fast (best-effort).
RUN nuclei -update-templates -silent 2>/dev/null || true

# Late fixups (kept out of the earlier cached layers): gitleaks' go.mod still
# declares the old zricethezav module path, and pipx installs ScoutSuite's CLI as
# `scout` -- add a `scoutsuite` alias so the persona's tool names resolve.
RUN go install github.com/zricethezav/gitleaks/v8@latest 2>/dev/null || true
# ScoutSuite's pipx entry point is `scout`; add a `scoutsuite` alias (pipx now
# writes shims to /usr/local/bin via PIPX_BIN_DIR).
RUN ln -sf /usr/local/bin/scout /usr/local/bin/scoutsuite 2>/dev/null || true
# jwt_tool needs its full requirements (ratelimit etc.); the hardcoded subset above
# missed some. Install from its requirements.txt now that the repo is cloned.
RUN pip install --break-system-packages -r /opt/jwt_tool/requirements.txt 2>/dev/null || true
# prowler is unusable on this image's Python 3.14: every prowler 4.x/5.x pins
# Requires-Python <3.13/<3.14, and the only installable line (3.x) pins pydantic
# v1 which crashes on 3.14. Remove the broken shim/venv so it isn't a landmine;
# cloud audit is covered by cloudfox + scoutsuite. (Revisit when prowler ships a
# Python 3.14 wheel.)
RUN rm -f /usr/local/bin/prowler; rm -rf /opt/pipx/venvs/prowler 2>/dev/null || true
# jwt_tool's createConfig() writes comment strings as INI keys containing ':',
# which Python 3.14's configparser rejects (InvalidWriteError) -> the tool crashes
# on first run. Strip colon/equals keys before writing (keeps real keys like proxy).
RUN echo '' | base64 -d > /tmp/pj.py && python3 /tmp/pj.py; rm -f /tmp/pj.py

# PATH robustness: the Go tools live in /usr/local/gopath/bin, which is on the
# image's default (non-login) env PATH, but a LOGIN shell (`bash -lc`) resets PATH
# via /etc/profile and drops it. Symlink every Go binary into /usr/local/bin (always
# on PATH in both shell kinds) + drop a profile.d file, so `gitleaks`, `cloudfox`,
# `kiterunner`, `dalfox`, ... resolve no matter how the agent spawns a shell. Also
# add the `kr` alias kiterunner tooling expects.
RUN for f in /usr/local/gopath/bin/*; do ln -sf "$f" /usr/local/bin/ 2>/dev/null || true; done; \
    ln -sf /usr/local/gopath/bin/kiterunner /usr/local/bin/kr 2>/dev/null || true; \
    chmod -R a+rX /usr/local/gopath/bin 2>/dev/null || true
RUN printf 'export PATH=/usr/local/gopath/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n' \
      > /etc/profile.d/00-hacksor-path.sh && chmod 0644 /etc/profile.d/00-hacksor-path.sh
# Make GOPATH writable so an agent-initiated `go install` (host-parity) doesn't hit
# permission-denied on the root-owned module cache.
RUN chmod 0777 /usr/local/gopath 2>/dev/null || true; mkdir -p /usr/local/gopath/pkg && chmod -R 0777 /usr/local/gopath/pkg 2>/dev/null || true
# Build-time assertion: fail loudly if any expected Go tool didn't resolve to PATH.
RUN for t in gitleaks cloudfox kiterunner kr dalfox cvemap asnmap gau gf gowitness hakrawler uncover tlsx mapcidr assetfinder waybackurls; do \
      command -v "$t" >/dev/null || { echo "MISSING on PATH: $t"; exit 1; }; done && echo "go tools on PATH: ok"
ENV GOFLAGS=-modcacherw

# trufflehog tries to self-update its own binary on every run; as the non-root
# agent that fails ("cannot move binary") and aborts the scan. Wrap it to always
# pass --no-update (a global flag) so scans just run. Idempotent: skip if already
# wrapped (the shim starts with a shebang, the real binary is ELF).
RUN if [ -x /usr/local/bin/trufflehog ] && ! head -c2 /usr/local/bin/trufflehog | grep -q '#!'; then \
      mv /usr/local/bin/trufflehog /usr/local/bin/trufflehog.real && \
      printf '#!/bin/sh\nexec /usr/local/bin/trufflehog.real --no-update "$@"\n' > /usr/local/bin/trufflehog && \
      chmod +x /usr/local/bin/trufflehog; \
    fi

# ---- Interactive PTY sessions + implicit subagents ----
# tmux backs hacksor-session (live consoles: msfconsole/ssh/REPLs/prompts).
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends tmux 2>/dev/null; rm -rf /var/lib/apt/lists/* 2>/dev/null || true
# hacksor-session: interactive terminal sessions for tools that need a live PTY.
RUN echo '' | base64 -d > /usr/local/bin/hacksor-session && chmod +x /usr/local/bin/hacksor-session
# hacksor-subagent: parallel divide-and-conquer Codex workers (codex exec fan-out).
RUN echo '' | base64 -d > /usr/local/bin/hacksor-subagent && chmod +x /usr/local/bin/hacksor-subagent

# Guarantee a from-scratch build can't silently ship without a core tool: HARD-fail
# if any is missing (the pipx/git/base64 installs above are best-effort `|| true`,
# so without this a flaky-network build could pass while a tool is absent). Optional
# heavyweights (phpggc/ysoserial/cloud) only warn.
RUN set -e; for t in semgrep trufflehog gitleaks jwt_tool sstimap scout scoutsuite cloudfish hacksor-findings tmux hacksor-session hacksor-subagent; do \
      command -v "$t" >/dev/null || { echo "BUILD FAILED: core tool missing: $t"; exit 1; }; done; \
    echo "core tools present: ok"; \
    for t in phpggc ysoserial cloudfox kiterunner; do command -v "$t" >/dev/null || echo "WARN optional tool missing: $t"; done; true

# The Hacksor codex-home (config, skills, notes) and working dirs are bind-mounted
# at runtime at their host paths; keys/providers come from a mounted ~/.opencodex.
LABEL org.hacksor.runtime="1"
CMD ["sleep", "infinity"]
