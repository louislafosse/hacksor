# Hacksor all-in-one runtime: a Kali Linux container with Codex + OpenCodex +
# the full Kali hacking arsenal. Users only need Docker; Hacksor runs the agent
# inside this container, so the whole pentest environment is bundled.
FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# Pin Kali's Cloudflare CDN, which serves .deb files directly. The default
# http.kali.org redirector rotates to volunteer mirrors, some of which have a
# broken TLS cert (SSL certificate verify failed) and abort the build.
RUN echo "deb http://kali.download/kali kali-rolling main contrib non-free non-free-firmware" > /etc/apt/sources.list

# Core system + the Kali toolset. Kali's repos carry all of these, so no
# per-tool source builds are needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git curl wget jq ripgrep unzip zip file build-essential \
    python3 python3-pip python3-venv pipx golang \
    # network / recon
    nmap masscan dnsutils whois netcat-traditional socat tcpdump iproute2 iputils-ping \
    openssl openssh-client proxychains4 \
    # VPN clients (reach targets over a tunnel) + sudo
    openvpn wireguard-tools iptables sudo \
    # web / app testing
    nikto whatweb wfuzz dirb dirbuster sqlmap hydra medusa \
    feroxbuster ffuf gobuster nuclei amass \
    # projectdiscovery + crawling
    httpx-toolkit subfinder naabu katana dnsx \
    # intercepting proxy + browser
    mitmproxy chromium chromium-driver fonts-liberation \
    # TLS / forensics / misc
    testssl.sh binwalk exiftool john hashid hashcat \
    # wordlists + exploit DB
    seclists wordlists exploitdb \
    # nodejs (for codex/ocx/playwright)
    nodejs npm \
    # reverse engineering: ghidra (decompiler, also REA's native-analysis
    # backend) and the Unicorn CPU emulator (+ python bindings) for shellcode
    # and firmware emulation. ghidra pulls openjdk; ~1.2 GB together.
    ghidra libunicorn-dev python3-unicorn \
 && rm -rf /var/lib/apt/lists/*

# GitHub CLI (gh) — PoC/exploit repo + code search (not in Kali apt).
RUN mkdir -p -m 755 /etc/apt/keyrings \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh && rm -rf /var/lib/apt/lists/*

# Some Kali packages install as *-toolkit or under /usr/bin with variant names;
# add convenient aliases the agent expects.
RUN ln -sf "$(command -v httpx-toolkit 2>/dev/null || echo /usr/bin/httpx)" /usr/local/bin/httpx 2>/dev/null || true
# Kali packages testssl as `testssl` (no .sh); expose the familiar name too.
RUN ln -sf "$(command -v testssl 2>/dev/null || echo /usr/bin/testssl)" /usr/local/bin/testssl.sh 2>/dev/null || true

# Extra Go tools not packaged (best-effort; the apt set above already covers most).
ENV GOPATH=/usr/local/gopath
ENV PATH="/usr/local/gopath/bin:${PATH}"
RUN go install -v github.com/hahwul/dalfox/v2@latest 2>/dev/null; \
    go install -v github.com/projectdiscovery/cvemap/cmd/cvemap@latest 2>/dev/null; \
    go install -v github.com/projectdiscovery/interactsh/cmd/interactsh-client@latest 2>/dev/null; \
    go install -v github.com/hakluke/hakrawler@latest 2>/dev/null; \
    go install -v github.com/lc/gau/v2/cmd/gau@latest 2>/dev/null; \
    go install -v github.com/tomnomnom/waybackurls@latest 2>/dev/null; \
    # recon expansion: ASN/CIDR, TLS grab, engine search, screenshots, param grep
    go install -v github.com/projectdiscovery/asnmap/cmd/asnmap@latest 2>/dev/null; \
    go install -v github.com/projectdiscovery/mapcidr/cmd/mapcidr@latest 2>/dev/null; \
    go install -v github.com/projectdiscovery/tlsx/cmd/tlsx@latest 2>/dev/null; \
    go install -v github.com/projectdiscovery/uncover/cmd/uncover@latest 2>/dev/null; \
    go install -v github.com/tomnomnom/assetfinder@latest 2>/dev/null; \
    go install -v github.com/tomnomnom/gf@latest 2>/dev/null; \
    # gowitness: its go.mod carries replace directives, which `go install` refuses;
    # build it from a clone (as the main module those directives are honored).
    (rm -rf /tmp/gowitness && git clone --depth 1 https://github.com/sensepost/gowitness /tmp/gowitness \
      && cd /tmp/gowitness && go build -o /usr/local/gopath/bin/gowitness . && cd / && rm -rf /tmp/gowitness) 2>/dev/null; \
    # secrets scanning, cloud enum, API route discovery
    # NOTE: gitleaks is NOT installed here. Its go.mod still declares the old
    # `zricethezav` module path, so `go install github.com/gitleaks/gitleaks/v8`
    # fails with "module declares its path as ..." — silently, under 2>/dev/null.
    # It is installed from the real path in the late-fixups block below.
    go install -v github.com/BishopFox/cloudfox@latest 2>/dev/null; \
    go install -v github.com/assetnote/kiterunner/cmd/kiterunner@latest 2>/dev/null; \
    # JavaScript analysis. jsluice parses JS with tree-sitter instead of grepping
    # it, so it finds URLs, paths, params and secrets that are assembled at
    # runtime rather than spelled out; sourcemapper rebuilds the original source
    # tree from a .js.map, which beats deobfuscating anything; subjs collects the
    # script URLs to feed both.
    go install -v github.com/BishopFox/jsluice/cmd/jsluice@latest 2>/dev/null; \
    go install -v github.com/denandz/sourcemapper@latest 2>/dev/null; \
    go install -v github.com/lc/subjs@latest 2>/dev/null; \
    # Dependency vulnerabilities from a lockfile or a reconstructed bundle.
    go install -v github.com/google/osv-scanner/v2/cmd/osv-scanner@latest 2>/dev/null; \
    # Subdomain takeover (fingerprint-based; complements nuclei's templates).
    go install -v github.com/haccer/subjack@latest 2>/dev/null; \
    # Mass DNS resolution with wildcard filtering, so a big subfinder/amass run
    # produces a list worth probing instead of thousands of wildcard hits.
    go install -v github.com/d3mondev/puredns/v2@latest 2>/dev/null; \
    # Web cache poisoning/deception. `go install` names the binary after the
    # module, so link the name anyone would actually type.
    (go install -v github.com/Hackmanit/Web-Cache-Vulnerability-Scanner@latest \
      && ln -sf /usr/local/gopath/bin/Web-Cache-Vulnerability-Scanner /usr/local/gopath/bin/wcvs) 2>/dev/null; \
    rm -rf /usr/local/gopath/pkg /root/.cache/go-build || true

# massdns backs puredns (it is a wrapper, not a resolver). Best-effort and in its
# own layer: the base apt block has no `|| true`, so a package missing from the
# mirror there would fail the whole build.
RUN apt-get -o Acquire::Retries=5 update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends massdns 2>/dev/null; \
    rm -rf /var/lib/apt/lists/* 2>/dev/null || true

# gf pattern set (xss/ssrf/sqli/lfi/redirect param greps)
RUN git clone --depth 1 https://github.com/1ndianl33t/Gf-Patterns /root/.gf 2>/dev/null || true

# pipx tools go to a WORLD-READABLE location, not root's ~/.local: on Linux the
# agent runs as the host uid (not root), and /root/.local is 0700 -> the agent
# gets "command not found" for every pipx tool. PIPX_HOME under /opt + shims in
# /usr/local/bin (already on PATH for all users) fixes that; each tool still lands
# in its own venv so incompatible deps (e.g. semgrep pydantic 2 vs prowler
# pydantic 1) don't collide. A final chmod (in the tools block) makes /opt/pipx
# traversable by everyone.
ENV PIPX_HOME=/opt/pipx
ENV PIPX_BIN_DIR=/usr/local/bin
# arjun (params), wafw00f (WAF detect), s3scanner (bucket enum)
RUN pipx install arjun 2>/dev/null || pip install --break-system-packages arjun || true
# curl_cffi: an HTTP client that impersonates a real browser's TLS + HTTP/2
# fingerprint (JA3/JA4 + Akamai), not just its User-Agent. Plain curl has a
# fingerprint of its own that Cloudflare, Akamai and DataDome recognise on
# sight, so a 403 from curl is often the fingerprint rather than the target.
# Measured in this image against tls.browserleaks.com: curl ja3_hash
# c654189f0cbcfb638bb74b824e790138, while impersonate="chrome" gives
# 84feddd6f06e125cfc66b95ff7445a34, safari ecdf4f49dd59effc439639da29186671
# and firefox 6f7889b9fb1a62a9577e685c1fcfa919. A library, not a CLI, so pipx
# cannot install it: it has to go into the system interpreter the agent uses.
# --ignore-installed certifi: curl_cffi now wants certifi >= 2026.10.19, and
# the image's copy comes from apt. A dpkg-installed package carries no RECORD
# file, so pip refuses to replace it ("Cannot uninstall certifi ... no RECORD
# file was found") and the build dies. Installing a fresh copy alongside it
# lands in /usr/local, which precedes the Debian path on sys.path.
RUN pip install --break-system-packages --ignore-installed certifi curl_cffi \
 && python3 -c "import curl_cffi, certifi; print('curl_cffi', curl_cffi.__version__, 'certifi', certifi.__version__)"
RUN pipx install wafw00f 2>/dev/null || pip install --break-system-packages wafw00f || true
RUN pipx install s3scanner 2>/dev/null || pip install --break-system-packages s3scanner || true
ENV PATH="/root/.local/bin:${PATH}"

# ---- Strix-parity additions: SAST, secrets, exploit + cloud tooling ----
# SAST (semgrep) and cloud audit (scoutsuite, prowler). Heavy Python; best-effort.
# `rm -rf /root/.cache` in the SAME layer: pip's wheel/http cache is build-time
# only, and a later cleanup layer cannot reclaim what an earlier one wrote.
# Measured at 514MB across the Python installs.
RUN { pipx install semgrep 2>/dev/null || pip install --break-system-packages semgrep || true; }; \
    rm -rf /root/.cache 2>/dev/null || true
RUN { pipx install scoutsuite 2>/dev/null || pip install --break-system-packages scoutsuite || true; }; \
    rm -rf /root/.cache 2>/dev/null || true
# prowler is NOT installed: it pins pydantic v1, which crashes on Python 3.14,
# so a later layer used to delete it again. Installing and deleting still ships
# the bytes — layers are additive — so it cost 410MB for nothing. Cloud audit is
# covered by cloudfox + scoutsuite. Revisit when prowler ships a 3.14 wheel.
# Make every pipx venv readable/traversable by the non-root agent uid.
RUN chmod -R a+rX /opt/pipx 2>/dev/null || true

# Secrets scanning: trufflehog (official installer; gitleaks comes from the go block).
#
# Retried, because the installer resolves the tag and then downloads the release
# asset in one unretried shot: a transient 504 from GitHub's CDN (observed) left
# the binary absent, and trufflehog is in the hard build assertion below, so one
# bad second upstream failed the whole image. Stderr is kept on the last attempt
# so a real failure says why instead of vanishing into /dev/null.
RUN for i in 1 2 3 4 5; do       if [ "$i" = 5 ]; then         curl -sSfL https://raw.githubusercontent.com/trufflesecurity/trufflehog/main/scripts/install.sh | sh -s -- -b /usr/local/bin || true;       else         (curl -sSfL https://raw.githubusercontent.com/trufflesecurity/trufflehog/main/scripts/install.sh | sh -s -- -b /usr/local/bin) >/dev/null 2>&1 || true;       fi;       command -v trufflehog >/dev/null && break;       echo "trufflehog install attempt $i failed; retrying in $((i * 5))s"; sleep $((i * 5));     done; command -v trufflehog >/dev/null || echo "WARN trufflehog still missing after retries"
# Fallback: build it from source when the release asset itself is unavailable.
#
# Not hypothetical — measured during this image's build: trufflehog's own
# linux_arm64 asset returned 504 on five consecutive attempts while another
# project's asset on the same CDN returned 200, so the failure was specific to
# that file and no amount of retrying would have helped. `go install` refuses
# the module (its go.mod carries replace directives), so it is cloned and built
# as the main module, the same way gowitness is above. -s -w because the
# unstripped binary is ~166MB.
#
# The module cache is deleted IN THIS LAYER, not a later one: layers are
# additive, the Go block's own cleanup has already run by here, and this build
# pulls ~1.7GB into GOPATH/pkg/mod. Measured: the image was 25.2GB with that
# cache left in, against 19.9GB before any of this.
RUN if ! command -v trufflehog >/dev/null 2>&1; then       echo "trufflehog: release asset unavailable, building from source";       TAG=$(curl -sS -m 30 https://api.github.com/repos/trufflesecurity/trufflehog/releases/latest | jq -r '.tag_name // empty');       rm -rf /tmp/th;       if [ -n "$TAG" ]; then git clone --depth 1 --branch "$TAG" https://github.com/trufflesecurity/trufflehog /tmp/th;       else git clone --depth 1 https://github.com/trufflesecurity/trufflehog /tmp/th; fi;       (cd /tmp/th && GOFLAGS=-modcacherw go build -ldflags "-s -w" -o /usr/local/bin/trufflehog .);       rm -rf /tmp/th /root/.cache/go-build /usr/local/gopath/pkg;     fi;     command -v trufflehog >/dev/null && echo "trufflehog: $(trufflehog --version 2>&1 | head -1)"

# Java + PHP runtimes for the deserialization gadget-chain tools below.
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends default-jre-headless php-cli 2>/dev/null; rm -rf /var/lib/apt/lists/* 2>/dev/null || true

# jwt_tool (JWT attacks), SSTImap (server-side template injection), phpggc (PHP
# gadget chains), ysoserial (Java gadget chains). Cloned/fetched + thin wrappers.
RUN git clone --depth 1 https://github.com/ticarpi/jwt_tool /opt/jwt_tool 2>/dev/null && (pip install --break-system-packages pycryptodomex termcolor cprint requests 2>/dev/null || true) && printf '#!/bin/sh\nexec python3 /opt/jwt_tool/jwt_tool.py "$@"\n' > /usr/local/bin/jwt_tool && chmod +x /usr/local/bin/jwt_tool || true
RUN git clone --depth 1 https://github.com/vladko312/SSTImap /opt/SSTImap 2>/dev/null && (pip install --break-system-packages -r /opt/SSTImap/requirements.txt 2>/dev/null || true) && printf '#!/bin/sh\nexec python3 /opt/SSTImap/sstimap.py "$@"\n' > /usr/local/bin/sstimap && chmod +x /usr/local/bin/sstimap || true
RUN git clone --depth 1 https://github.com/ambionics/phpggc /opt/phpggc 2>/dev/null && printf '#!/bin/sh\nexec php /opt/phpggc/phpggc "$@"\n' > /usr/local/bin/phpggc && chmod +x /usr/local/bin/phpggc || true
# Retried, and the partial file removed between attempts: GitHub's release CDN
# was observed returning 504 for this 59MB asset (and trufflehog's 30MB one)
# while a 5MB asset on the same host served fine, so the failure correlates with
# size and is transient. Without the retry a single bad minute shipped an image
# with no ysoserial and only a WARN to say so. There is no mirror to fall back
# to: it is not in Kali's repos and not on JitPack, so if every attempt fails
# the build continues without it and the warn list reports it.
RUN for i in 1 2 3 4 5; do \
      rm -f /opt/ysoserial.jar; \
      if curl -sSfL --retry 3 --retry-delay 5 -o /opt/ysoserial.jar \
           https://github.com/frohoff/ysoserial/releases/latest/download/ysoserial-all.jar 2>/dev/null \
         && [ -s /opt/ysoserial.jar ]; then \
        printf '#!/bin/sh\nexec java -jar /opt/ysoserial.jar "$@"\n' > /usr/local/bin/ysoserial; \
        chmod +x /usr/local/bin/ysoserial; \
        break; \
      fi; \
      echo "ysoserial download attempt $i failed; retrying in $((i * 10))s"; sleep $((i * 10)); \
    done; \
    command -v ysoserial >/dev/null || { rm -f /opt/ysoserial.jar; echo "WARN ysoserial unavailable upstream (504); image ships without it"; }

# hacksor-findings: structured vulnerability knowledge base + Markdown report
# generator (base64-embedded stdlib CLI; no COPY, builds under every builder).
RUN echo '' | base64 -d > /usr/local/bin/hacksor-findings && chmod +x /usr/local/bin/hacksor-findings


# Codex CLI (app-server) + OpenCodex proxy (ocx) + browser control.
# Primary browser: Camoufox (stealth Firefox) via camofox-browser + camofox-mcp
# — resists Cloudflare/Turnstile and humanizes clicks/typing. agent-browser and
# Playwright/Chromium remain as fallbacks.
# Firefox runtime deps Camoufox needs (Kali has most, add the GTK/X/audio libs)
# plus: xvfb+xauth (virtual display — camofox-browser needs a display), x11vnc +
# websockify (headed/VNC display mode via the MCP `toggle_display`), and
# libnss3-tools (certutil — trust the mitmproxy CA in a browser profile).
# Note: pick libasound2t64 (Debian/Kali time_t transition) when present, else
# the classic libasound2 — the bare name has no install candidate on current
# Kali. Retries make the step tolerant of a flaky mirror.
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    libgtk-3-0 libdbus-glib-1-2 libxtst6 libxt6 libx11-xcb1 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libpci3 xauth xvfb \
    x11vnc websockify libnss3-tools \
    "$(apt-cache show libasound2t64 >/dev/null 2>&1 && echo libasound2t64 || echo libasound2)" \
 && rm -rf /var/lib/apt/lists/*
ENV CHROME_BIN=/usr/bin/chromium
ENV PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/playwright
# Retry config makes the global install tolerant of a flaky registry connection
# (ECONNRESET / TLS disconnects seen on slow links).
RUN npm config set fetch-retries 6 \
 && npm config set fetch-retry-mintimeout 20000 \
 && npm config set fetch-retry-maxtimeout 180000 \
 && npm config set fetch-timeout 600000 \
 && npm install -g @openai/codex @bitkyc08/opencodex @playwright/mcp agent-browser \
    camofox-mcp camofox-browser rea-agents \
    `# JS unminification/unpacking, for bundles with no source map. wakaru and` \
    `# webcrack overlap deliberately: they fail on different inputs, and a` \
    `# bundle that defeats one often yields to the other. retire finds known-` \
    `# vulnerable library versions straight from the shipped JS.` \
    wakaru webcrack retire \
    `# LLM/prompt-injection testing for AI-backed targets. promptfoo only: garak` \
    `# and PyRIT pull torch/transformers and would add gigabytes to an image` \
    `# that is already ~20GB.` \
    promptfoo \
 && (PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/playwright npx -y playwright install chromium 2>/dev/null || true) \
 && npm cache clean --force \
 && rm -rf /root/.npm /root/.cache 2>/dev/null || true

# Build camofox-browser's native dependencies.
#
# npm 12 does NOT run install scripts unless the package is approved
# (`allowScripts`), and it only WARNS about the ones it skipped. camofox-browser
# depends on better-sqlite3 (`prebuild-install || node-gyp rebuild`) and argon2
# (`node-gyp-build`), so on this image they installed with no compiled binding
# at all: no `build/`, no `prebuilds/`. The browser then died on the very first
# tool call with "Could not locate the bindings file", every Camoufox session
# failed, and the agent fell back to Playwright. Nothing in the build logged an
# error, because npm treated the skipped scripts as a warning.
#
# Approve the two native packages, rebuild them, and FAIL the build if either
# cannot be LOADED, so this cannot silently regress again.
#
# The check is a require(), not a file test. It used to assert
# build/Release/better_sqlite3.node existed, which broke when better-sqlite3
# 13 switched to shipping prebuilt binaries under prebuilds/<platform>.node:
# the package was installed and working, and the build failed anyway. What
# matters is that the module loads — that is the exact failure this guards.
RUN cd /usr/local/lib/node_modules/camofox-browser  && npm install-scripts approve better-sqlite3 argon2 --no-allow-scripts-pin  && npm rebuild better-sqlite3 argon2  && node -e "require('/usr/local/lib/node_modules/camofox-browser/node_modules/better-sqlite3')"  && node -e "require('/usr/local/lib/node_modules/camofox-browser/node_modules/argon2')"  && echo "camofox-browser native deps built"

# Raise OpenCodex's provider model-discovery timeout. ocx hard-codes an 8s abort
# on the upstream /models fetch, which these catalogs routinely exceed (measured
# from this image: OpenRouter ~11s for 449 models, Cheaper Inference 5-13s for
# its ~480 KB catalog). On a timeout ocx logs "discovery ... threw Error
# [fallback=configured]", serves only the configured models, and never retries
# until the proxy restarts — so the model picker comes up empty or with a
# handful of rows. 45s covers the slow cases; a fetch that misses that is a real
# outage, not a slow catalog.
#
# Patch by CONTENT, not by filename: pinning the path broke the image build when
# ocx 2.68 refactored provider-fetch.ts into a re-export barrel and moved the
# constant to provider-models.ts. Every runtime-image publish failed from then
# on, so this fix never actually reached anyone. Rewrite wherever the constant
# lives under catalog/, and still FAIL the build if it is nowhere to be found, so
# a future release cannot silently drop it and bring the empty picker back.
RUN OCX_CATALOG=/usr/local/lib/node_modules/@bitkyc08/opencodex/src/codex/catalog \
 && grep -rl 'AbortSignal\.timeout(8000)' "$OCX_CATALOG" > /tmp/ocx-patch-targets \
 && [ -s /tmp/ocx-patch-targets ] \
 && xargs -r sed -i 's/AbortSignal\.timeout(8000)/AbortSignal.timeout(45000)/g' < /tmp/ocx-patch-targets \
 && grep -rq 'AbortSignal\.timeout(45000)' "$OCX_CATALOG" \
 && rm -f /tmp/ocx-patch-targets

# REA finds Ghidra through this (it never installs Ghidra or Java itself), and
# Kali's package lays the installation out at /usr/share/ghidra.
ENV GHIDRA_INSTALL_DIR=/usr/share/ghidra

# Patch the installed camofox-browser + camofox-mcp so the MCP browser can solve
# Cloudflare Turnstile, work behind the loopback intercept proxy, and lazy-start
# the heavy Firefox only when actually used. The patch script (3 files) is
# base64-embedded so no shell escaping can corrupt it and it builds identically
# under BuildKit, the classic builder, and the in-app bollard build. Idempotent +
# best-effort.
#   - camofox-browser context-pool.js: disable_coop (click the cross-origin
#     Turnstile iframe), ignoreHTTPSErrors (browse through the proxy), geoip gated
#     off for loopback proxies (the public-IP probe fails through mitmproxy and
#     blocked create_tab).
#   - camofox-browser tab.js: when a page-level selector click fails (element is
#     in a cross-origin iframe / closed shadow root), walk child frames and click
#     by bbox centre with a real mouse sequence — so the existing MCP `click` tool
#     solves Turnstile.
#   - camofox-mcp client.js: LAZY-START — the first browser API request ensures the
#     daemon is up (health-check, then `camofox-browser server start --background`
#     with the RAM caps), so the heavy Firefox stays down until a browser tool is
#     actually used instead of autostarting with the container.
# Because we patch the INSTALLED packages, the runtime must launch these binaries
# (it does — the app/MCP run `camofox-browser`/`camofox-mcp`, not `npx @latest`).
RUN echo '' \
    | base64 -d > /tmp/hacksor-cb-patch.js \
 && node /tmp/hacksor-cb-patch.js \
 && rm -f /tmp/hacksor-cb-patch.js

# cloudfish: passive subdomain discovery via Cloudflare's own DNS scanner (a data
# source distinct from CT logs / passive DNS). Reworked stdlib-only CLI, base64
# embedded (no COPY; builds under every builder). Creds come from Hacksor Settings
# (written to ~/.cloudflare, bind-mounted into the container) or -k/-e/-a flags.
RUN echo '' | base64 -d > /usr/local/bin/cloudfish && chmod +x /usr/local/bin/cloudfish

# Pre-fetch the Camoufox engine so the first browser use isn't a slow 1.3 GB
# download at runtime (best-effort — camofox-browser downloads it otherwise).
# Time-bounded so a slow/flaky link can't hang the build for hours; if it's
# skipped, camofox-browser fetches the engine on first use.
RUN (timeout 1800 camofox-browser fetch 2>/dev/null || timeout 1800 npx -y camofox-browser@latest fetch 2>/dev/null || true)

# Pre-fetch nuclei templates so the first scan is fast (best-effort).
RUN nuclei -update-templates -silent 2>/dev/null || true

# Late fixups (kept out of the earlier cached layers): gitleaks' go.mod still
# declares the old zricethezav module path, and pipx installs ScoutSuite's CLI as
# `scout` -- add a `scoutsuite` alias so the persona's tool names resolve.
# The module cache is removed in THIS layer, not a later one: layers are
# additive and the main Go block's cleanup ran long before this. Leaving it cost
# 428MB resident, and made the `chmod -R` below rewrite all of it into another
# 448MB layer.
RUN go install github.com/zricethezav/gitleaks/v8@latest 2>/dev/null || true; \
    rm -rf /usr/local/gopath/pkg /root/.cache/go-build 2>/dev/null || true
# ScoutSuite's pipx entry point is `scout`; add a `scoutsuite` alias (pipx now
# writes shims to /usr/local/bin via PIPX_BIN_DIR).
RUN ln -sf /usr/local/bin/scout /usr/local/bin/scoutsuite 2>/dev/null || true
# jwt_tool needs its full requirements (ratelimit etc.); the hardcoded subset above
# missed some. Install from its requirements.txt now that the repo is cloned.
RUN pip install --break-system-packages -r /opt/jwt_tool/requirements.txt 2>/dev/null || true
# prowler is unusable on this image's Python 3.14: every prowler 4.x/5.x pins
# Requires-Python <3.13/<3.14, and the only installable line (3.x) pins pydantic
# v1 which crashes on 3.14. Remove the broken shim/venv so it isn't a landmine;
# cloud audit is covered by cloudfox + scoutsuite. (Revisit when prowler ships a
# Python 3.14 wheel.)
# Nothing to remove any more: prowler is no longer installed above. Kept as a
# cleanup for images built before that change.
RUN rm -f /usr/local/bin/prowler; rm -rf /opt/pipx/venvs/prowler 2>/dev/null || true
# jwt_tool's createConfig() writes comment strings as INI keys containing ':',
# which Python 3.14's configparser rejects (InvalidWriteError) -> the tool crashes
# on first run. Strip colon/equals keys before writing (keeps real keys like proxy).
RUN echo '' | base64 -d > /tmp/pj.py && python3 /tmp/pj.py; rm -f /tmp/pj.py

# PATH robustness: the Go tools live in /usr/local/gopath/bin, which is on the
# image's default (non-login) env PATH, but a LOGIN shell (`bash -lc`) resets PATH
# via /etc/profile and drops it. Symlink every Go binary into /usr/local/bin (always
# on PATH in both shell kinds) + drop a profile.d file, so `gitleaks`, `cloudfox`,
# `kiterunner`, `dalfox`, ... resolve no matter how the agent spawns a shell. Also
# add the `kr` alias kiterunner tooling expects.
RUN for f in /usr/local/gopath/bin/*; do ln -sf "$f" /usr/local/bin/ 2>/dev/null || true; done; \
    ln -sf /usr/local/gopath/bin/kiterunner /usr/local/bin/kr 2>/dev/null || true; \
    chmod -R a+rX /usr/local/gopath/bin 2>/dev/null || true
RUN printf 'export PATH=/usr/local/gopath/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n' \
      > /etc/profile.d/00-hacksor-path.sh && chmod 0644 /etc/profile.d/00-hacksor-path.sh
# Make GOPATH writable so an agent-initiated `go install` (host-parity) doesn't hit
# permission-denied on the root-owned module cache.
# `chmod -R` on the module cache rewrote every file's metadata, which puts a
# full copy of the tree in this layer. The cache is now empty by the time we get
# here, so the directory itself is all that needs to be writable — an
# agent-initiated `go install` populates it at runtime.
RUN chmod 0777 /usr/local/gopath 2>/dev/null || true; \
    mkdir -p /usr/local/gopath/pkg && chmod 0777 /usr/local/gopath/pkg 2>/dev/null || true
# Build-time assertion: fail loudly if any expected Go tool didn't resolve to PATH.
RUN for t in gitleaks cloudfox kiterunner kr dalfox cvemap asnmap gau gf gowitness hakrawler uncover tlsx mapcidr assetfinder waybackurls \
             jsluice sourcemapper subjs osv-scanner subjack puredns wcvs; do \
      command -v "$t" >/dev/null || { echo "MISSING on PATH: $t"; exit 1; }; done && echo "go tools on PATH: ok"
ENV GOFLAGS=-modcacherw

# trufflehog tries to self-update its own binary on every run; as the non-root
# agent that fails ("cannot move binary") and aborts the scan. Wrap it to always
# pass --no-update (a global flag) so scans just run. Idempotent: skip if already
# wrapped (the shim starts with a shebang, the real binary is ELF).
RUN if [ -x /usr/local/bin/trufflehog ] && ! head -c2 /usr/local/bin/trufflehog | grep -q '#!'; then \
      mv /usr/local/bin/trufflehog /usr/local/bin/trufflehog.real && \
      printf '#!/bin/sh\nexec /usr/local/bin/trufflehog.real --no-update "$@"\n' > /usr/local/bin/trufflehog && \
      chmod +x /usr/local/bin/trufflehog; \
    fi

# ---- Interactive PTY sessions + implicit subagents ----
# tmux backs hacksor-session (live consoles: msfconsole/ssh/REPLs/prompts).
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends tmux 2>/dev/null; rm -rf /var/lib/apt/lists/* 2>/dev/null || true
# hacksor-session: interactive terminal sessions for tools that need a live PTY.
RUN echo '' | base64 -d > /usr/local/bin/hacksor-session && chmod +x /usr/local/bin/hacksor-session
# hacksor-subagent: parallel divide-and-conquer Codex workers (codex exec fan-out).
RUN echo '' | base64 -d > /usr/local/bin/hacksor-subagent && chmod +x /usr/local/bin/hacksor-subagent

# Headers for the Python extensions the tools below build from source: yara-python
# needs Python.h (baddns, guarddog) and pygit2 needs libgit2 (guarddog). Without
# these both installs fail at the compiler, and because each install is
# best-effort the image shipped without them and only the WARN line said so.
# Best-effort and in its own layer, like the other late apt additions.
RUN apt-get -o Acquire::Retries=5 update \
 && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
    python3-dev libgit2-dev libssl-dev 2>/dev/null; \
    rm -rf /var/lib/apt/lists/* 2>/dev/null || true

# ---- JS/web additions: archive mining, GraphQL, takeover, supply chain ----
# ParamSpider mines parameters out of web archives (passive; complements arjun,
# which probes the live target).
RUN pipx install git+https://github.com/devanshbatham/ParamSpider.git 2>/dev/null || true; \
    rm -rf /root/.cache 2>/dev/null || true
# BadDNS (takeover + dangling-record classes) and GuardDog (behavioural malware
# analysis of npm/PyPI packages).
# These two build yara-python and pygit2 from source, so they leave the largest
# pip cache of any layer. Cleaned here, where it still reclaims the space.
RUN pipx install baddns 2>/dev/null || true; rm -rf /root/.cache 2>/dev/null || true
RUN pipx install guarddog 2>/dev/null || true; rm -rf /root/.cache 2>/dev/null || true
# graphql-cop has no setup.py/pyproject, so pipx cannot install it: clone it into
# its own venv and shim the entrypoint, which is what pipx would have done.
RUN (git clone --depth 1 https://github.com/dolevf/graphql-cop /opt/graphql-cop \
      && python3 -m venv /opt/graphql-cop/.venv \
      && /opt/graphql-cop/.venv/bin/pip install --no-cache-dir -r /opt/graphql-cop/requirements.txt \
      && printf '#!/bin/sh\nexec /opt/graphql-cop/.venv/bin/python /opt/graphql-cop/graphql-cop.py "$@"\n' \
         > /usr/local/bin/graphql-cop \
      && chmod +x /usr/local/bin/graphql-cop \
      && chmod -R a+rX /opt/graphql-cop) 2>/dev/null || true


# hacksor-shodan: Shodan pivots, above all the favicon-hash one — a favicon is
# served by the APPLICATION, so hashing an icon you can reach finds every other
# host serving the same app (staging, forgotten dev boxes, the origin behind a
# CDN). `uncover` can run the query but cannot produce the hash; nothing else in
# the image computes it. Stdlib-only (MurmurHash3 implemented inline and checked
# against the mmh3 package), and `host` works with no API key at all via
# InternetDB. Embedded, not COPYed, like the other bundled CLIs.
RUN echo '' | base64 -d > /usr/local/bin/hacksor-shodan && chmod +x /usr/local/bin/hacksor-shodan
# The official Shodan CLI too, for the subcommands this wrapper does not cover
# (scan, alert, stats). `--force` because a failed pipx install leaves a venv
# behind with no app script in it, and a plain retry then reports "already
# installed" and links nothing — which is exactly how this shipped missing the
# first time while the build said nothing.
RUN for i in 1 2 3; do \
      pipx install --force shodan >/dev/null 2>&1 && break; \
      echo "shodan CLI install attempt $i failed; retrying"; sleep $((i * 5)); \
    done; rm -rf /root/.cache 2>/dev/null || true; \
    command -v shodan >/dev/null || echo "WARN shodan CLI missing after retries"
RUN chmod -R a+rX /opt/pipx 2>/dev/null || true

# Guarantee a from-scratch build can't silently ship without a core tool: HARD-fail
# if any is missing (the pipx/git/base64 installs above are best-effort `|| true`,
# so without this a flaky-network build could pass while a tool is absent). Optional
# heavyweights (phpggc/ysoserial/cloud) only warn.
RUN set -e; for t in semgrep trufflehog gitleaks jwt_tool sstimap scout scoutsuite cloudfish hacksor-findings tmux hacksor-session hacksor-subagent hacksor-shodan; do \
      command -v "$t" >/dev/null || { echo "BUILD FAILED: core tool missing: $t"; exit 1; }; done; \
    echo "core tools present: ok"; \
    for t in phpggc ysoserial cloudfox kiterunner; do command -v "$t" >/dev/null || echo "WARN optional tool missing: $t"; done; \
    for t in wakaru webcrack retire paramspider baddns guarddog graphql-cop massdns \
             promptfoo shodan; do \
      command -v "$t" >/dev/null || echo "WARN optional tool missing: $t"; done; true

# The Hacksor codex-home (config, skills, notes) and working dirs are bind-mounted
# at runtime at their host paths; keys/providers come from a mounted ~/.opencodex.
LABEL org.hacksor.runtime="1"
CMD ["sleep", "infinity"]
